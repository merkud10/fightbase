[Unit]
Description=SSH tunnel to Telegram relay on bridge VPS
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/ssh -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/root/.ssh/known_hosts -o BatchMode=yes -i /root/.ssh/codex_bridge_tunnel -L 127.0.0.1:8788:127.0.0.1:8788 codexbridge@179.254.164.181
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
